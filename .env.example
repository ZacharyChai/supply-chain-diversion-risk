# Copy to .env (gitignored) and fill in, or export these directly in your shell.

# Optional. Comtrade's free /public/v1/preview/ endpoint works with no key (see
# src/fetch_comtrade.py) but rate-limits aggressively. A key from
# https://comtradeplus.un.org routes to the higher-limit authenticated endpoint.
COMTRADE_API_KEY=

# Required for src/fetch_census.py (the US-side cross-check pull). Register free at
# https://api.census.gov/data/key_signup.html -- the main pipeline (Comtrade ->
# risk scoring) runs without this; it only skips the cross-check step.
CENSUS_API_KEY=
